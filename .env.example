# ============================================================
# What's Your Story — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets.
# ============================================================

# --- Supabase (REQUIRED) ---
# From your Supabase project → Settings → API (see SUPABASE_SETUP.md).
# Use the publishable / anon key — NEVER the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for canonical URLs, sitemaps, OG tags).
# Example: https://whatsyourstory.example.com
SITE_URL=http://localhost:3000

# --- Uploads ---
# Directory for locally-uploaded images such as the founder portrait,
# relative to the project root. (Story cover images live in Supabase Storage.)
UPLOAD_DIR=data/uploads
# Max upload size in megabytes (per file).
MAX_UPLOAD_MB=5

# --- Local data ---
# SQLite file location for local-only features (site content, founder profile,
# categories, rate limits, activity log). Story and submission content lives
# in Supabase, not here.
DATA_DIR=data
