# ============================================================
# What's Your Story — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets.
# ============================================================

# --- Supabase (REQUIRED) ---
# From your Supabase project → Settings → API (see SUPABASE_SETUP.md).
# Use the publishable / anon key — NEVER the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for canonical URLs, sitemaps, OG tags).
# Example: https://whatsyourstory.example.com
SITE_URL=http://localhost:3000

# --- Uploads ---
# Everything uploaded (story covers, homepage collage, founder portrait) goes
# to the public Supabase Storage bucket `story-images`. Nothing is written to
# the local filesystem, so no upload directory variable exists any more.
# Max upload size in megabytes (per file).
MAX_UPLOAD_MB=5

# --- Email notifications (Resend) ---
# Optional. When set, an e-mail notification is sent to STORY_NOTIFICATION_EMAIL
# every time a visitor submits a story through /share. Submissions are ALWAYS
# saved even if e-mail is not configured or delivery fails.
# See README → "Email notifications (Resend)" for setup instructions.
# NEVER put a real key in .env.example — only in .env.local (gitignored).
RESEND_API_KEY=
# Where submission notifications should arrive (your inbox).
STORY_NOTIFICATION_EMAIL=
# The verified sender address configured in Resend, e.g. "What's Your Story <notifications@yourdomain.com>".
STORY_NOTIFICATION_FROM=

# NOTE: DATA_DIR and UPLOAD_DIR no longer exist. All data lives in Supabase
# (Postgres + Storage); there is no local database file and no local upload
# directory. Remove those variables from any existing .env.local / Vercel
# project settings.
